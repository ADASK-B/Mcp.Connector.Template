# Normalize text in the index and keep cross-platform gates reproducible.
* text=auto
.gitattributes text eol=lf

# Files consumed by Unix tools or governed by the LF EditorConfig contract.
*.cs text eol=lf
*.csproj text eol=lf
*.cue text eol=lf
*.props text eol=lf
*.slnx text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.py text eol=lf
*.tpl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
LICENSE text eol=lf
Dockerfile text eol=lf
