@Mcp.Connector.Template_HostAddress = http://localhost:5076

### Process liveness
GET {{Mcp.Connector.Template_HostAddress}}/healthz
Accept: application/json

###

### Traffic readiness
GET {{Mcp.Connector.Template_HostAddress}}/readyz
Accept: application/json

###

### Exact release identity
GET {{Mcp.Connector.Template_HostAddress}}/version
Accept: application/json

###

### MCP initialize — start a new MCP session
POST {{Mcp.Connector.Template_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
        "protocolVersion": "2025-03-26",
        "capabilities": {},
        "clientInfo": {
            "name": "http-file-client",
            "version": "1.0.0"
        }
    }
}

###

### MCP tools/list — discover available tools
POST {{Mcp.Connector.Template_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
mcp-session-id: {{$dotenv MCP_SESSION_ID}}

{
    "jsonrpc": "2.0",
    "id": 2,
    "method": "tools/list",
    "params": {}
}

###

### MCP tools/call — invoke the deterministic synthetic echo
POST {{Mcp.Connector.Template_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
mcp-session-id: {{$dotenv MCP_SESSION_ID}}

{
    "jsonrpc": "2.0",
    "id": 3,
    "method": "tools/call",
    "params": {
        "name": "echoSynthetic",
        "arguments": {
            "message": "platform-test-payload"
        }
    }
}

###
